generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// スタッフ
model Staff {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   // 例: "正社員", "アルバイト"
  color     String   @default("#3b82f6") // シフト表示用の色
  shifts    Shift[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// シフト
model Shift {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String   // "09:00"形式
  endTime   String   // "18:00"形式
  breakTime Int      @default(60) // 休憩時間（分）
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([date])
}

// シフトテンプレート（繰り返しパターン用）
model ShiftTemplate {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  breakTime Int      @default(60)
  createdAt DateTime @default(now())
}
